# คัดลอกเป็น .env แล้วเปลี่ยนค่า (ห้าม commit .env)
# ต้องยาวอย่างน้อย 32 ตัวอักษร ใช้ร่วมกันระหว่าง gateway กับ identity-service
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# สร้างด้วย: openssl rand -hex 32  ใช้ร่วมกันระหว่าง wallet-service กับ Bruno (ตอน provider = mock)
PAYMENT_WEBHOOK_SECRET=change-me

# mock หรือ omise
PAYMENT_PROVIDER=mock
# ใช้เมื่อ PAYMENT_PROVIDER=omise (ขึ้นต้นด้วย skey_test_)
OMISE_SECRET_KEY=
