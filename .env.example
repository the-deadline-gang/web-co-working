# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า (ห้าม commit .env เด็ดขาด)
#   cp .env.example .env
# ตอนรัน service ด้วย ./mvnw spring-boot:run ต้องโหลดค่าเข้า shell ก่อนทุกครั้ง:
#   set -a; source ../../.env; set +a      (รันจากในโฟลเดอร์ backend/<service>)

# ---------- ใช้ร่วมกันหลาย service ----------
# gateway + identity ใช้ตัวเดียวกัน ต้องยาวอย่างน้อย 32 ตัวอักษร   สร้าง: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# identity → wallet (/internal/**) ใช้ตัวเดียวกัน และใส่ใน api-tests/.env ด้วย   สร้าง: openssl rand -hex 32
INTERNAL_API_TOKEN=change-me

# ---------- wallet-service: การชำระเงิน ----------
# omise = สร้าง QR และเช็กการจ่ายผ่าน Omise test mode (ต้องมีเน็ต) ← ทีมใช้ตัวนี้
# mock  = สร้าง QR เอง ไม่ออกเน็ต ผลการจ่ายต้องยิง /webhooks/payment เอง (Bruno 6 Webhook)
PAYMENT_PROVIDER=omise

# Secret key ของ Omise "Test mode" เท่านั้น ต้องขึ้นต้นด้วย skey_test_
# (ถ้าใส่ live key หรือเว้นว่างตอน PAYMENT_PROVIDER=omise แอปจะ start ไม่ขึ้น)
# วิธีเอา key ดูใน README หัวข้อ "ตั้งค่า Omise test mode"
OMISE_SECRET_KEY=skey_test_xxxxxxxxxxxxxxxxxxxx

# ใช้ตรวจลายเซ็นของ /webhooks/payment (Bruno เซ็นด้วยค่านี้)   สร้าง: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=change-me

# เบอร์ PromptPay ที่ใส่ใน QR ตอน PAYMENT_PROVIDER=mock เท่านั้น
# ⚠️ QR ของ mock สแกนจ่ายได้จริง เงินจะเข้าเบอร์นี้ แต่ระบบไม่รู้ ห้ามสแกนจ่ายตอนเดโม
PROMPTPAY_ID=0812345678
