meta {
  name: 07 Pay topup (successful)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/webhooks/payment
  body: text
  auth: none
}

headers {
  Content-Type: application/json
  X-Signature: {{webhookSignature}}
}

body:text {
  {{webhookBody}}
}

assert {
  res.status: eq 200
}

script:pre-request {
  const CryptoJS = require("crypto-js");
  function signAndSet(body, secret) {
    bru.setVar("webhookBody", body);
    bru.setVar("webhookSignature", CryptoJS.HmacSHA256(body, secret).toString());
  }

  const eventId = `evt_bruno_${Date.now()}`;
  bru.setVar("eventId", eventId);
  const body = JSON.stringify({
    eventId,
    gatewayRef: bru.getEnvVar("gatewayRef"),
    status: "successful",
    amountThb: 500,
    paidAt: new Date().toISOString()
  });
  signAndSet(body, bru.getProcessEnv("PAYMENT_WEBHOOK_SECRET"));
}

docs {
  W-08 จำลอง Payment Gateway แจ้งว่า topup ที่สร้างใน 03 จ่ายแล้ว
  gatewayRef ถูกตั้งให้อัตโนมัติใน 05 ลายเซ็นคำนวณด้วย PAYMENT_WEBHOOK_SECRET จาก api-tests/.env
  ใช้ได้ทั้ง provider=mock และ omise (endpoint นี้ไม่สนว่า charge มาจากไหน)
}
