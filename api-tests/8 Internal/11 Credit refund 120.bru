meta {
  name: 11 Credit refund 120
  type: http
  seq: 11
}

post {
  url: {{walletUrl}}/internal/wallets/{{testUserId}}/credit
  body: json
  auth: none
}

headers {
  X-Internal-Token: {{process.env.INTERNAL_API_TOKEN}}
  Content-Type: application/json
  Idempotency-Key: {{refundKey}}
}

body:json {
  {
    "amount": 120,
    "type": "REFUND",
    "refType": "BOOKING",
    "refId": 192,
    "note": "ยกเลิกก่อน 5 ชม. คืน 50%"
  }
}

assert {
  res.status: eq 200
  res.body.amount: eq 120
  res.body.balanceAfter: eq 180
}

script:pre-request {
  bru.setVar("refundKey", `booking-192-cancel-${Date.now()}`);
}
