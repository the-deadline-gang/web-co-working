meta {
  name: 17 Unknown user
  type: http
  seq: 17
}

post {
  url: {{walletUrl}}/internal/wallets/1/debit
  body: json
  auth: none
}

headers {
  X-Internal-Token: {{process.env.INTERNAL_API_TOKEN}}
  Content-Type: application/json
  Idempotency-Key: {{uKey}}
}

body:json {
  {
    "amount": 10,
    "type": "BOOKING",
    "refType": "BOOKING",
    "refId": 1
  }
}

assert {
  res.status: eq 404
  res.body.code: eq WALLET_NOT_FOUND
}

script:pre-request {
  bru.setVar("uKey", `u-${Date.now()}`);
}

docs {
  userId 1 ไม่มี wallet (ถ้าในเครื่องมี ให้เปลี่ยนเป็นเลขอื่น)
}
