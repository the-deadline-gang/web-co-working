meta {
  name: 19 Balance after race
  type: http
  seq: 19
}

post {
  url: {{walletUrl}}/internal/wallets
  body: json
  auth: none
}

headers {
  X-Internal-Token: {{process.env.INTERNAL_API_TOKEN}}
  Content-Type: application/json
}

body:json {
  {
    "userId": {{testUserId}}
  }
}

assert {
  res.status: eq 200
  res.body.balance: eq 60
}

docs {
  ใช้ create wallet (เรียกซ้ำได้) เป็นทางดูยอด ต้องเหลือ 60.00 ไม่ติดลบ
}
