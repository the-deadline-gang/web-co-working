meta {
  name: 14 refType TOPUP
  type: http
  seq: 14
}

post {
  url: {{walletUrl}}/internal/wallets/{{testUserId}}/debit
  body: json
  auth: none
}

headers {
  X-Internal-Token: {{process.env.INTERNAL_API_TOKEN}}
  Content-Type: application/json
  Idempotency-Key: {{zKey}}
}

body:json {
  {
    "amount": 10,
    "type": "BOOKING",
    "refType": "TOPUP",
    "refId": 1
  }
}

assert {
  res.status: eq 400
}

script:pre-request {
  bru.setVar("zKey", `z-${Date.now()}`);
}
