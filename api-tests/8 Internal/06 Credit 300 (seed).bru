meta {
  name: 06 Credit 300 (seed)
  type: http
  seq: 6
}

post {
  url: {{walletUrl}}/internal/wallets/{{testUserId}}/credit
  body: json
  auth: none
}

headers {
  X-Internal-Token: {{process.env.INTERNAL_API_TOKEN}}
  Content-Type: application/json
  Idempotency-Key: {{seedKey}}
}

body:json {
  {
    "amount": 300,
    "type": "REFUND",
    "refType": "BOOKING",
    "refId": 1,
    "note": "เติมยอดตั้งต้นสำหรับทดสอบ"
  }
}

assert {
  res.status: eq 200
  res.body.amount: eq 300
  res.body.balanceAfter: eq 300
  res.body.type: eq REFUND
}

script:pre-request {
  bru.setVar("seedKey", `seed-${Date.now()}`);
}
