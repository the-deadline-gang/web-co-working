meta {
  name: 05 Create wallet missing userId
  type: http
  seq: 5
}

post {
  url: {{walletUrl}}/internal/wallets
  body: json
  auth: none
}

headers {
  X-Internal-Token: {{process.env.INTERNAL_API_TOKEN}}
  Content-Type: application/json
}

body:json {
  {}
}

assert {
  res.status: eq 400
  res.body.details.userId: isDefined
}
