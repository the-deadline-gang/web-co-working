meta {
  name: 10 Debit more than balance
  type: http
  seq: 10
}

post {
  url: {{walletUrl}}/internal/wallets/{{testUserId}}/debit
  body: json
  auth: none
}

headers {
  X-Internal-Token: {{process.env.INTERNAL_API_TOKEN}}
  Content-Type: application/json
  Idempotency-Key: {{bigKey}}
}

body:json {
  {
    "amount": 100,
    "type": "BOOKING",
    "refType": "BOOKING",
    "refId": 2
  }
}

assert {
  res.status: eq 422
  res.body.code: eq INSUFFICIENT_BALANCE
  res.body.details.balance: eq "60.00"
  res.body.details.shortfall: eq "40.00"
}

script:pre-request {
  bru.setVar("bigKey", `big-${Date.now()}`);
}
