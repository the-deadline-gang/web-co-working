meta {
  name: 13 Credit with TOPUP type
  type: http
  seq: 13
}

post {
  url: {{walletUrl}}/internal/wallets/{{testUserId}}/credit
  body: json
  auth: none
}

headers {
  X-Internal-Token: {{process.env.INTERNAL_API_TOKEN}}
  Content-Type: application/json
  Idempotency-Key: {{yKey}}
}

body:json {
  {
    "amount": 10,
    "type": "TOPUP",
    "refType": "BOOKING",
    "refId": 1
  }
}

assert {
  res.status: eq 400
}

script:pre-request {
  bru.setVar("yKey", `y-${Date.now()}`);
}

docs {
  TOPUP ต้องมาจาก webhook เท่านั้น
}
