meta {
  name: 03 Create wallet without token
  type: http
  seq: 3
}

post {
  url: {{walletUrl}}/internal/wallets
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userId": {{testUserId}}
  }
}

assert {
  res.status: eq 401
  res.body.code: eq INVALID_INTERNAL_TOKEN
}
