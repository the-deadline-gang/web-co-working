meta {
  name: 16 Missing Idempotency-Key
  type: http
  seq: 16
}

post {
  url: {{walletUrl}}/internal/wallets/{{testUserId}}/debit
  body: json
  auth: none
}

headers {
  X-Internal-Token: {{process.env.INTERNAL_API_TOKEN}}
  Content-Type: application/json
}

body:json {
  {
    "amount": 10,
    "type": "BOOKING",
    "refType": "BOOKING",
    "refId": 1
  }
}

assert {
  res.status: eq 400
  res.body.code: eq VALIDATION_FAILED
}

tests {
  test("บอกว่าขาด header Idempotency-Key", function () {
    expect(res.body.details).to.have.property("Idempotency-Key");
  });
}
