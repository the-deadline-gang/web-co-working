meta {
  name: 04 Get topup (owner)
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/topups/{{topupId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.topupId: eq {{topupId}}
  res.body.status: eq PENDING
  res.body.qrImage: isString
}

docs {
  ยิงต่อจาก 03 ทันทีต้องได้ PENDING
  ถ้าไปกด Mark as Successful ใน Omise Dashboard ก่อน จะได้ PAID แทน (ไม่ใช่ bug)
  เคสหลังจ่ายแล้วอยู่ใน 9 Omise (manual)
}
