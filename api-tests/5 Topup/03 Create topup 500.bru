meta {
  name: 03 Create topup 500
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/topups
  body: json
  auth: none
}

body:json {
  {
    "amountThb": 500
  }
}

assert {
  res.status: eq 201
  res.body.status: eq PENDING
  res.body.amountThb: eq 500
  res.body.displayId: startsWith PAY-
  res.body.qrImage: isString
  res.body.paidAt: isNull
  res.body.balanceAfter: isNull
}

script:post-response {
  bru.setVar("topupId", res.body.topupId);
}

docs {
  W-07 สร้าง topup แล้วเก็บ topupId ไว้
  qrImage: provider=mock เป็น data:image/png;base64,...  provider=omise เป็น URL https://api.omise.co/...
  ทดสอบการจ่ายแบบ webhook → 6 Webhook (หา gatewayRef ให้อัตโนมัติ)
  ทดสอบการจ่ายผ่าน Omise จริง → 9 Omise (manual)
}
