meta {
  name: 01 Staff login (Admin)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/staff/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.role: eq Admin
  res.body.permissions: contains role.manage
}
