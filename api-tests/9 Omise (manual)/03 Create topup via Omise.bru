meta {
  name: 03 Create topup via Omise
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/topups
  body: json
  auth: none
}

body:json {
  {
    "amountThb": 500
  }
}

assert {
  res.status: eq 201
  res.body.status: eq PENDING
  res.body.qrImage: startsWith https://
  res.body.paidAt: isNull
}

script:post-response {
  bru.setVar("omiseTopupId", res.body.topupId);
  bru.setVar("omiseTokenAmount", res.body.tokenAmount);
}

docs {
  qrImage ต้องเป็น URL ของ Omise (https://api.omise.co/...)
  ถ้าได้ data:image/png;base64,... แปลว่า wallet ยังรันเป็น mock อยู่
  → เช็ก PAYMENT_PROVIDER=omise ใน .env แล้ว restart wallet (ถ้ายังไม่เปลี่ยนให้เปิด terminal ใหม่ ดู README)
  เปิด URL ใน qrImage ดูได้ จะเห็น QR PromptPay ที่ Omise ออกให้
}
